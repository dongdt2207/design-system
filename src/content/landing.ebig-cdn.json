    {
      "type": "manifesto",
      "props": {
        "text": "We built this CDN so files reach people as fast as possible, with as little configuration as possible.",
        "asideLeft": "2024",
        "asideRight": "R2 + Workers"
      }
    },
    {
      "type": "split",
      "props": {
        "eyebrow": "How it works",
        "text": "You push files to a bucket. Ebig CDN places them at 300+ edge locations, pre-compressed, checks access with JWT right at the edge, and returns them with correct cache headers. No origin server to maintain, no invalidation to wait on.",
        "visual": {
          "type": "stats",
          "items": [
            {
              "value": "1",
              "label": "commands to deploy"
            },
            {
              "value": "0",
              "label": "origin servers to manage"
            },
            {
              "value": "< 50 ms",
              "label": "for a purge to reach every edge"
            },
            {
              "value": "∞",
              "label": "egress bandwidth, at no charge"
            }
          ]
        }
      }
    },
    {
      "type": "feature",
      "props": {
        "index": "01",
        "title": "Served from the nearest edge",
        "description": "Files live on R2 and are cached at every Cloudflare edge. Someone in Hanoi, Tokyo, or Frankfurt fetches from a location a few dozen kilometers away.",
        "visualSide": "right",
        "visual": {
          "type": "terminal",
          "lines": [
            {
              "text": "$ curl -sI https://cdn.ebig.co/app/main.js",
              "tone": "dim"
            },
            {
              "text": "HTTP/2 200"
            },
            {
              "text": "cf-cache-status: HIT",
              "tone": "ok"
            },
            {
              "text": "cf-ray: 8c3f2a1b-HAN"
            },
            {
              "text": "content-encoding: br"
            },
            {
              "text": "x-response-time: 11ms",
              "tone": "ok"
            }
          ]
        }
      }
    },
    {
      "type": "feature",
      "props": {
        "index": "02",
        "title": "Access checked at the edge",
        "description": "You sign the JWT on your side; Ebig CDN verifies it at the edge before returning the file. A private file never leaves the edge if the signature is wrong or expired.",
        "visualSide": "left",
        "visual": {
          "type": "terminal",
          "lines": [
            {
              "text": "$ curl -sI https://cdn.ebig.co/private/report.pdf",
              "tone": "dim"
            },
            {
              "text": "HTTP/2 401"
            },
            {
              "text": "",
              "tone": "dim"
            },
            {
              "text": "$ curl -sI -H \"Authorization: Bearer $TOKEN\" \\",
              "tone": "dim"
            },
            {
              "text": "    https://cdn.ebig.co/private/report.pdf",
              "tone": "dim"
            },
            {
              "text": "HTTP/2 200",
              "tone": "ok"
            },
            {
              "text": "cache-control: private, max-age=0"
            }
          ]
        }
      }
    },
    {
      "type": "feature",
      "props": {
        "index": "03",
        "title": "Compressed ahead of time, not at request time",
        "description": "Every asset is Brotli-compressed at the highest level on upload, not on delivery. People receive files 20–30% smaller than gzip, and the edge spends no CPU on it.",
        "visualSide": "right",
        "visual": {
          "type": "terminal",
          "lines": [
            {
              "text": "$ ebig-cdn deploy ./dist",
              "tone": "dim"
            },
            {
              "text": "uploading 142 files"
            },
            {
              "text": "brotli  main.js      412 KB → 98 KB",
              "tone": "ok"
            },
            {
              "text": "brotli  vendor.js    1.2 MB → 287 KB",
              "tone": "ok"
            },
            {
              "text": "brotli  style.css    88 KB → 14 KB",
              "tone": "ok"
            },
            {
              "text": "done in 3.4s · purge propagated to 312 edges"
            }
          ]
        }
      }
    },
